{
	"name": "justtype-react",
	"version": "0.1.0",
	"description": "JustType's 8-key predictive keyboard as a React component for AAC web apps.",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": ["*.css"],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
		"./styles.css": "./dist/style.css",
		"./data/*": "./data/*"
	},
	"files": ["dist", "data"],
	"scripts": {
		"build:data": "node scripts/build-data.mjs English && node scripts/build-data.mjs Espanol",
		"dev": "npm run build:data && vite",
		"build": "npm run build:data && tsc -p tsconfig.build.json && vite build",
		"typecheck": "tsc --noEmit",
		"test": "npm run build:data && vitest run"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@types/node": "^22.9.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^6.3.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.6.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}

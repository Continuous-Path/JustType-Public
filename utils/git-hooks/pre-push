#!/usr/bin/env bash
# Pre-push gate: makes sure the project check has passed recently before any push.
# One-time install per clone:  git config core.hooksPath utils/git-hooks
# Bypass in an emergency:      git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

stamp=0
[[ -f .gradle/jt-check-stamp ]] && stamp="$(cat .gradle/jt-check-stamp 2>/dev/null || echo 0)"
now="$(date +%s)"

# A check that finished in the last 15 minutes counts — covers the normal
# "agent ran ./jt check, committed, now pushing" flow without a re-run.
if (( now - stamp < 900 )); then
	exit 0
fi

echo "pre-push: no recent ./jt check — running it now (tests + spotless + detekt)..."
if ./jt check; then
	exit 0
fi

echo ""
echo "pre-push: ./jt check FAILED — push blocked."
echo "Fix the failures (paste the summary above into Claude if unsure),"
echo "or bypass in an emergency with: git push --no-verify"
exit 1

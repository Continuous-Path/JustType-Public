<?xml version="1.0" encoding="utf-8"?>
<!-- JT Layout Container - 3x3 grid with selection list -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jtLayoutContainer"
    android:orientation="horizontal"
    style="@style/KeyboardLayoutContainer">

    <include layout="@layout/include_jt_key_grid" />

    <org.continuouspath.justtype.view.SelectionListView
        android:id="@+id/selectionList"
        style="@style/SelectionList"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.4"
        android:layout_margin="8dp" />

</LinearLayout>

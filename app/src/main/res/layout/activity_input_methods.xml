<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/colorBackground"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/input_methods_title"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/touchInputHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_methods_touch_heading"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:gravity="start"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/touchInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/inputMethodDirectSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/input_methods_direct_selection"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <CheckBox
                    android:id="@+id/inputMethodDirectionalSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/input_methods_directional_selection"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <CheckBox
                    android:id="@+id/inputMethodTouchScreenSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/input_methods_touch_screen_switch"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/setupTouchScreenMethodButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_direct_selection"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/otherInputHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_methods_other_heading"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:gravity="start"
                android:paddingTop="16dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/otherInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/headTrackingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/inputMethodHeadTracking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_head_tracking"
                        android:paddingTop="8dp"
                        android:paddingBottom="0dp" />

                    <TextView
                        android:id="@+id/headTrackingHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_head_tracking_hint"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:paddingStart="32dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/inputMethodJoystick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/input_methods_joystick"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <CheckBox
                    android:id="@+id/inputMethodMouseJoystick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/input_methods_mouse_joystick"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <CheckBox
                    android:id="@+id/inputMethodSingleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/input_methods_single_switch"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <CheckBox
                    android:id="@+id/inputMethodTwoSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/input_methods_two_switch"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/setupOtherMethodButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_head_tracking"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <!-- Auditory Feedback heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_methods_heading_auditory"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:paddingTop="24dp"
                android:paddingBottom="8dp" />

            <!-- Beep when key is pressed -->
            <LinearLayout
                android:id="@+id/beepKeyFeedbackLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/input_methods_beep_key"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/beepKeyFeedbackSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Error beep -->
            <LinearLayout
                android:id="@+id/errorBeepLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/input_methods_error_beep"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/errorBeepSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <!-- Vibrate on key activation -->
            <LinearLayout
                android:id="@+id/vibrateKeyFeedbackLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sr_input_methods_vibration_feedback"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/vibrateKeyFeedbackSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Speak each selected key -->
            <LinearLayout
                android:id="@+id/speakSelectedKeyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_speak_key"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_speak_key_desc"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/speakSelectedKeySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <!-- Speak punctuation -->
            <LinearLayout
                android:id="@+id/speakPunctuationLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="0dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_speak_punct"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_speak_punct_desc"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/speakPunctuationSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Speak each selected word -->
            <LinearLayout
                android:id="@+id/speakSelectedWordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="0dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_speak_word"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_speak_word_desc"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/speakSelectedWordSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <!-- Speak settings prompts aloud -->
            <LinearLayout
                android:id="@+id/speakSettingsPromptsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/input_methods_speak_prompts"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/speakSettingsPromptsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Visual Feedback heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_methods_heading_visual"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="8dp" />

            <!-- Flash key when pressed -->
            <LinearLayout
                android:id="@+id/flashKeyFeedbackLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/input_methods_flash_key"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/flashKeyFeedbackSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Touch Overlay heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_methods_heading_touch_overlay"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:paddingTop="24dp"
                android:paddingBottom="8dp" />

            <!-- Touch overlay timeout slider -->
            <LinearLayout
                android:id="@+id/touchOverlayTimeoutLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/input_methods_touch_timeout"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_methods_touch_timeout_min"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/touchOverlayTimeoutSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="8" />

                    <TextView
                        android:id="@+id/touchOverlayTimeoutValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 sec"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>


<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="4dp"
        android:background="?android:attr/colorBackground">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_back"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textSize="20sp"
                android:textAlignment="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- Warning banner for IME not enabled -->
        <LinearLayout
            android:id="@+id/imeWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF44336"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/imeWarningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_ime_warning"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/openKeyboardSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_open_keyboard_settings"
                android:backgroundTint="#FFD32F2F"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Warning banner for the Navigation Keyboard accessibility service not enabled -->
        <LinearLayout
            android:id="@+id/navWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF44336"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_nav_warning"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/enableNavKeyboardButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_enable_nav_keyboard"
                android:backgroundTint="#FFD32F2F"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

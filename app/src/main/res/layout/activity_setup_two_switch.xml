<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/colorBackground"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setup_ts_title"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/activateGreenButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_ts_activate_green"
                    android:textColor="@color/switch_setup_button_text"
                    android:textStyle="bold"
                    android:backgroundTint="@color/switch_setup_green" />

                <ImageButton
                    android:id="@+id/clearGreenButton"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/content_desc_clear_green_switch"
                    android:src="@drawable/ic_clear"
                    android:backgroundTint="@color/switch_setup_green" />
            </LinearLayout>

            <TextView
                android:id="@+id/greenSwitchLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/switch_undefined"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="8dp"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/activateRedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_ts_activate_red"
                    android:textColor="@color/switch_setup_button_text"
                    android:textStyle="bold"
                    android:backgroundTint="@color/switch_setup_red" />

                <ImageButton
                    android:id="@+id/clearRedButton"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/content_desc_clear_red_switch"
                    android:src="@drawable/ic_clear"
                    android:backgroundTint="@color/switch_setup_red" />
            </LinearLayout>

            <TextView
                android:id="@+id/redSwitchLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/switch_undefined"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="8dp"
                android:paddingBottom="12dp" />

            <!-- Touch Screen Switch toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_use_touch_screen_switch"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/touchScreenSwitchToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ts_highlight_timeout"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/highlightTimeoutValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disabled (0s)"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/highlightTimeoutSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="120" />
            </LinearLayout>

            <!-- Stuck Switch Timeout (mirrors Keyboard Settings two_switch page) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sr_two_switch_stuck_timeout"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/stuckTimeoutValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 sec"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/stuckTimeoutSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="28" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/showColorBandSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ts_show_color_band"
                android:paddingTop="16dp"
                android:paddingBottom="8dp" />

            <!-- Phase 3C: "Disable Highlight" removed; red/green key
                 highlighting is now always-on in Two-Switch mode. -->

            <!-- Auto-repeat key activations -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_ts_auto_repeat_key"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/twoSwitchAutoRepeatSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Auto-repeat delay -->
            <LinearLayout
                android:id="@+id/twoSwitchAutoRepeatDelayRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/twoSwitchAutoRepeatDelayValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.00 s"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/twoSwitchAutoRepeatDelaySeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="55" />
            </LinearLayout>

            <!-- Auto-repeat switch activations -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_ts_auto_repeat_switch"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/twoSwitchRepeatActivationSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Auto-repeat switch activation delay -->
            <LinearLayout
                android:id="@+id/twoSwitchRepeatActivationDelayRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/twoSwitchRepeatActivationDelayValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.00 s"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/twoSwitchRepeatActivationDelaySeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="55" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/twoSwitchBeepActivationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ts_beep_activation"
                android:paddingTop="8dp"
                android:paddingBottom="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>


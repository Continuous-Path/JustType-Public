<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/colorBackground"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setup_head_tracking"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Phase 3C: Section heading — Zone Thresholds -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ht_section_zone_thresholds"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <!-- Dead zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_dead_zone"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.10"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/headTrackingDeadZoneSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="40" />

                    <TextView
                        android:id="@+id/headTrackingDeadZoneValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:text="0.25"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Active zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_active_zone"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.10"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/headTrackingActiveZoneSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="65" />

                    <TextView
                        android:id="@+id/headTrackingActiveZoneValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:text="0.45"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Exit zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_exit_zone"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.10"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/headTrackingExitZoneSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="89" />

                    <TextView
                        android:id="@+id/headTrackingExitZoneValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.80"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Key Activation Threshold -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_key_activation"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_key_activation_desc"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_ht_key_activation_min"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/headTrackingKeyActThresholdSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/headTrackingKeyActThresholdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20%"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Aim Tolerance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_aim_tolerance"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_aim_tolerance_desc"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_ht_aim_tolerance_min"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/headTrackingAimToleranceSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/headTrackingAimToleranceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30%"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Exit/Pause Delay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_exit_delay"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_exit_delay_desc"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_ht_exit_delay_min"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/headTrackingExitDelaySeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="30" />

                    <TextView
                        android:id="@+id/headTrackingExitDelayValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:text="3.5s"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Restart Delay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_restart_timer"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_restart_timer_desc"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_ht_restart_timer_min"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/headTrackingRestartDelaySeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="25" />

                    <TextView
                        android:id="@+id/headTrackingRestartDelayValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.5s"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Phase 3C: Section heading — Tuning and Feedback -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ht_section_tuning_feedback"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <!-- Corner Weighting (Phase 3C: moved from page top to first item
                 under "Tuning and Feedback"). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_corner_bias"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.50"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/cornerBiasSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="150" />

                    <TextView
                        android:id="@+id/cornerBiasValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:text="1.75"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Pitch Scale (Vertical Sensitivity) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_vertical_sensitivity"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_vertical_desc"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.00"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/pitchScaleSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/pitchScaleValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.30"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Responsiveness (Response Curve) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_response_curve"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_ht_response_desc"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.50"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/responseCurveSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/responseCurveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.00"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Correction-gesture feedback (mirrors Keyboard Settings head_tracking page) -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/correctionBeepSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sr_head_tracking_correction_beep"
                android:paddingTop="12dp"
                android:paddingBottom="8dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/correctionFlashRedSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sr_head_tracking_correction_flash_red"
                android:paddingTop="8dp"
                android:paddingBottom="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>


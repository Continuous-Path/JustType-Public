<?xml version="1.0" encoding="utf-8"?>
<!-- Scan Layout Button Pool - 8 buttons that get moved between rows dynamically -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanButtonPool"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:visibility="visible"
    android:visibility="gone">

    <org.continuouspath.justtype.view.SquareButton
        android:id="@+id/btn0Scan"
        style="@style/ScanKeyboardButton" />

    <org.continuouspath.justtype.view.SquareButton
        android:id="@+id/btn1Scan"
        style="@style/ScanKeyboardButton" />

    <org.continuouspath.justtype.view.SquareButton
        android:id="@+id/btn2Scan"
        style="@style/ScanKeyboardButton" />

    <org.continuouspath.justtype.view.SquareButton
        android:id="@+id/btn3Scan"
        style="@style/ScanKeyboardButton" />

    <org.continuouspath.justtype.view.SquareButton
        android:id="@+id/btn4Scan"
        style="@style/ScanKeyboardButton" />

    <org.continuouspath.justtype.view.SquareButton
        android:id="@+id/btn5Scan"
        style="@style/ScanKeyboardButton" />

    <org.continuouspath.justtype.view.SquareButton
        android:id="@+id/btn6Scan"
        style="@style/ScanKeyboardButton" />

    <org.continuouspath.justtype.view.SquareButton
        android:id="@+id/btn7Scan"
        style="@style/ScanKeyboardButton" />

</LinearLayout>

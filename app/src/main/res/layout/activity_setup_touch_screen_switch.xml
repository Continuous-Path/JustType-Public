<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/colorBackground"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setup_tss_title"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- How it works heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_how_it_works"
                android:textSize="18sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <!-- Explanation text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_explanation"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingBottom="16dp" />

            <!-- Screen diagram -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_rectangle_bg"
                    android:gravity="center"
                    android:text="@string/setup_tss_left_label"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_rectangle_bg"
                    android:gravity="center"
                    android:text="@string/setup_tss_right_label"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_usage_tips"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:lineSpacingMultiplier="1.3"
                android:paddingBottom="24dp" />

            <!-- Settings heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/heading_settings"
                android:textSize="18sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <!-- Touchscreen Switch Mode (Phase 3C: previously hidden; now shown
                 as the label for the mode RadioGroup so the Phase 3B INFO icon
                 has a visible label to sit next to). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/touch_screen_switch_mode_label"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>
            <RadioGroup
                android:id="@+id/switchModeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">
                <RadioButton
                    android:id="@+id/switchModeSingle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_screen_switch_mode_single" />
                <RadioButton
                    android:id="@+id/switchModeTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_screen_switch_mode_two" />
            </RadioGroup>

            <!-- Flash on activation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touch_screen_switch_flash"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/flashOnActivationSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Show touch-region border -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/show_region_border"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/showRegionBorderSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Beep on activation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touch_screen_switch_beep"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/beepOnActivationSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Debounce slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_touch_debounce"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <!-- Phase 3D B-TC-CONFIRM-OVERLAY-TIMEOUT: replaced the duplicate
                 setup_tss_debounce_desc (info already in INFO PROMPT) with the
                 setup_tss_note text that previously lived at the page bottom. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_note"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="italic"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/debounceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/debounceSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="50" />
            </LinearLayout>

            <!-- Button height slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_button_height"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_button_height_desc"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/buttonHeightValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10%"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/buttonHeightSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="19" />
            </LinearLayout>

            <!-- Overlay opacity slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_overlay_opacity"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_tss_overlay_opacity_desc"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/overlayOpacityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/overlayOpacitySeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="18" />
            </LinearLayout>

            <!-- Overlay mode toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_tss_overlay_mode"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/overlayModeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Phase 3D B-TC-CONFIRM-OVERLAY-TIMEOUT: removed the out-of-date
                 setup_tss_overlay_mode_desc that previously sat here, and added
                 the Touch Timeout slider. Slider is gated by Overlay Mode (see
                 SetupTouchScreenSwitchActivity.updateTouchTimeoutEnabled). -->

            <!-- Touch Timeout slider — only meaningful when Overlay Mode is ON.
                 Shares pref key with Directional Selection (KEY_TOUCH_OVERLAY_TIMEOUT_SEC). -->
            <TextView
                android:id="@+id/touchTimeoutLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_touch_timeout"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/touchTimeoutRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/touchTimeoutValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 sec"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/touchTimeoutSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="8" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

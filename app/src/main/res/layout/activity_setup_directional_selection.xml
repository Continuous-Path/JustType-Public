<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/colorBackground"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setup_dir_title"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- How it works heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_how_it_works"
                android:textSize="18sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <!-- Explanation text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_explanation"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingBottom="16dp" />

            <!-- Direction diagram -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_8_directions"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_arrows"
                android:textSize="28sp"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_swipe_desc"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="24dp" />

            <!-- Settings heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/heading_settings"
                android:textSize="18sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <!-- Swipe sensitivity slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_swipe_sensitivity"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_swipe_distance_desc"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/swipeDistanceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5%"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/swipeDistanceSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="18" />
            </LinearLayout>

            <!-- Visual indicator showing actual swipe distance relative to screen width -->
            <View
                android:id="@+id/swipeDistanceIndicator"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorPrimary" />

            <!-- Show touch-region border -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/show_region_border"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/showRegionBorderSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Touch overlay timeout slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_touch_timeout"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_touch_timeout_desc"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/touchTimeoutValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 sec"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/touchTimeoutSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="8" />
            </LinearLayout>

            <!-- Debounce slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_swipe_debounce"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_dir_debounce_desc"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/debounceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:paddingEnd="12dp" />

                <SeekBar
                    android:id="@+id/debounceSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="50" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

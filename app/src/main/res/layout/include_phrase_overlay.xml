<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phraseOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#DD212121">

        <TextView
            android:id="@+id/phraseOverlayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phrase_overlay_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phraseOverlayPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="@string/phrase_overlay_prompt"
            android:gravity="start" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="#FF424242">

            <TextView
                android:id="@+id/phraseOverlayContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp"
                android:gravity="start|top" />
        </ScrollView>

        <TextView
            android:id="@+id/phraseOverlayAbbrevLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFEB3B"
            android:textSize="14sp"
            android:text="@string/phrase_overlay_abbrev_label" />

        <TextView
            android:id="@+id/phraseOverlayAbbrev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#FF424242"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:lineSpacingExtra="2dp"
            android:gravity="start|top" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/phraseOverlayCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_cancel" />

            <Button
                android:id="@+id/phraseOverlayDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/label_done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>


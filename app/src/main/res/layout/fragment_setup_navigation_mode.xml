<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_back"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/navigation_mode_title"
                android:textSize="20sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/navigation_mode_info_overview"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/navigation_mode_toggle_label"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/navigationModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/openAccessibilitySettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/navigation_mode_open_accessibility_settings" />

        <Button
            android:id="@+id/showOverlayNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/navigation_mode_show_overlay_now" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/navigation_mode_info_requires_service"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingTop="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <!-- Live Drag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sr_nav_live_drag"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/liveDragToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_prompt_nav_live_drag"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_appearance_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingBottom="8dp" />

        <!-- Theme -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_appearance_theme"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/navThemeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_appearance_theme_system"
                android:textColor="?android:attr/textColorPrimary" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_appearance_theme_light"
                android:textColor="?android:attr/textColorPrimary" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_appearance_theme_dark"
                android:textColor="?android:attr/textColorPrimary" />
        </RadioGroup>

        <!-- Key opacity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_appearance_key_opacity"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/keyOpacitySeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/keyOpacityValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Background opacity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_appearance_panel_opacity"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/panelOpacitySeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/panelOpacityValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Keyboard size -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_appearance_size"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/sizeSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/sizeValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Transparency mode -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_appearance_transparency_mode"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/transparencyModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/modeGlyphOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_appearance_mode_glyph_outline"
                android:textColor="?android:attr/textColorPrimary" />

            <RadioButton
                android:id="@+id/modeGlyphOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_appearance_mode_glyph_only"
                android:textColor="?android:attr/textColorPrimary" />

            <RadioButton
                android:id="@+id/modeUniform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_appearance_mode_uniform"
                android:textColor="?android:attr/textColorPrimary" />
        </RadioGroup>

        <!-- Hide drag handle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nav_appearance_hide_handle"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/hideHandleToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_appearance_apply_hint"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />
    </LinearLayout>
</ScrollView>

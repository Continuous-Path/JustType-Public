<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="24dp"
    android:focusableInTouchMode="true">

    <TextView
        android:id="@+id/overlayTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/phrase_overlay_title"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/overlayInstructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/phrase_overlay_instructions"
        android:textColor="@android:color/white"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/overlayTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/phraseLabel"
        android:labelFor="@+id/phraseInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/phrase_overlay_phrase_label"
        android:textColor="@android:color/white"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/overlayInstructions" />

    <EditText
        android:id="@+id/phraseInput"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@android:color/white"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
        android:imeOptions="actionNext"
        android:maxLines="4"
        android:minLines="3"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/phraseLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintBottom_toTopOf="@id/abbrevLabel" />

    <TextView
        android:id="@+id/abbrevLabel"
        android:labelFor="@+id/abbrevInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/phrase_overlay_abbrev_full_label"
        android:textColor="@android:color/white"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/phraseInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/abbrevInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@android:color/white"
        android:imeOptions="actionDone"
        android:inputType="textVisiblePassword|textNoSuggestions"
        android:maxLines="2"
        android:minLines="1"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/abbrevLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


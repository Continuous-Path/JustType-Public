<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/colorBackground"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setup_mj_title"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tuning presets: one tap sets movement-needed + resting-zone. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sr_mouse_joystick_preset_header"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/mjPresetLightButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sr_mouse_joystick_preset_light" />

            <Button
                android:id="@+id/mjPresetStandardButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sr_mouse_joystick_preset_standard" />

            <Button
                android:id="@+id/mjPresetFirmButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sr_mouse_joystick_preset_firm" />

            <!-- Corner bias -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_mj_corner_bias"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.50"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/mjCornerBiasSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="150" />

                    <TextView
                        android:id="@+id/mjCornerBiasValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.35"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Dead zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_mj_dead_zone"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.01"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/mjDeadZoneSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="79" />

                    <TextView
                        android:id="@+id/mjDeadZoneValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.20"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Active zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_mj_active_zone"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.01"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/mjActiveZoneSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="89" />

                    <TextView
                        android:id="@+id/mjActiveZoneValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.55"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Sensitivity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_mj_sensitivity"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/mjSensitivitySeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="295" />

                    <TextView
                        android:id="@+id/mjSensitivityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Exit delay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_mj_exit_delay"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.5s"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/mjExitDelaySeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="45" />

                    <TextView
                        android:id="@+id/mjExitDelayValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.0s"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <!-- Reengage delay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_mj_reengage_hysteresis"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0s"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <SeekBar
                        android:id="@+id/mjReengageSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="40" />

                    <TextView
                        android:id="@+id/mjReengageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.75s"
                        android:paddingStart="8dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/mjCalibrateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_mj_calibrate" />

            <Button
                android:id="@+id/resetToDefaultsButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/reset_to_defaults" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

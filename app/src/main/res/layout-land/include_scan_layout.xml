<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape scan layout: center preview + key rows in a left column, selection
     list as a full-height right column using the spare horizontal space. Same IDs
     as the portrait variant; ScanLayoutController branches on scanLeftColumn. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanLayoutContainer"
    android:orientation="horizontal"
    android:baselineAligned="false"
    style="@style/KeyboardLayoutContainer"
    tools:visibility="visible"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/scanLeftColumn"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:ignore="InconsistentLayout">

        <!-- Center preview; sized programmatically (square) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scanTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.continuouspath.justtype.view.SquareTextView
                android:id="@+id/centerLabelScan"
                style="@style/CenterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_center_label"
                android:background="@color/keyboard_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Key rows container -->
        <LinearLayout
            android:id="@+id/scanKeysContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp">

            <LinearLayout
                android:id="@+id/scanLargeRowTop"
                style="@style/ScanRowContainer" />

            <LinearLayout
                android:id="@+id/scanLargeRowBottom"
                style="@style/ScanRowContainer" />

            <LinearLayout
                android:id="@+id/scanSmallRow"
                style="@style/ScanRowContainer" />

            <include layout="@layout/include_scan_button_pool" tools:visibility="invisible" />

        </LinearLayout>
    </LinearLayout>

    <!-- Selection list beside the keys: uses the horizontal space landscape frees up -->
    <LinearLayout
        android:id="@+id/selectionListScanContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/rounded_rectangle_bg"
        android:layout_marginStart="8dp" />

</LinearLayout>

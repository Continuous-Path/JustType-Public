<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sender permission enforced by every HeadBoard-facing receiver (pose frames,
         head-tracking state/resume, clear-highlights, switch events). Normal protection
         level while the two apps are signed with different keys; upgrade to signature
         once release signing is unified. -->
    <permission android:name="org.continuouspath.justtype.permission.RECEIVE_HEADBOARD_EVENT"
        android:protectionLevel="normal" />
    <!-- JustType holds its own permission so internal sends of protected actions pass. -->
    <uses-permission android:name="org.continuouspath.justtype.permission.RECEIVE_HEADBOARD_EVENT" />

    <!-- Permission to send events to HeadBoard (defined by HeadBoard) -->
    <uses-permission android:name="org.continuouspath.headboard.permission.RECEIVE_JUSTTYPE_EVENT" />
    
    <!-- Permission for system overlay (Directional Selection mode) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Haptic (key/error vibration feedback) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Language-pack downloads (word DBs; later LLM files). No POST_NOTIFICATIONS needed: the
         system DownloadManager posts its progress notification under its own package identity. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility (API 30+): see email apps so a crash report can open one directly. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".JustTypeApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_justtype"
        android:roundIcon="@mipmap/ic_justtype_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Empty taskAffinity: launched from the IME with NEW_TASK, the overlay must get
             its own ephemeral task instead of surfacing the app's Settings back stack. -->
        <activity
            android:name=".activity.PhraseOverlayActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".activity.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".welcome.WelcomeGuideActivity"
            android:exported="false"
            android:parentActivityName=".activity.SettingsActivity" />
        <activity
            android:name=".activity.BackupRestoreActivity"
            android:exported="false"
            android:parentActivityName=".activity.SettingsActivity" />
        <activity
            android:name=".activity.LanguagesActivity"
            android:exported="false"
            android:parentActivityName=".activity.SettingsActivity" />
        <activity android:name=".activity.DeveloperSettingsActivity"
            android:exported="false"
            android:parentActivityName=".activity.SettingsActivity" />
        <activity-alias
            android:name=".SettingsActivity"
            android:targetActivity=".activity.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_justtype"
            android:roundIcon="@mipmap/ic_justtype_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".activity.InputMethodsActivity"
            android:exported="false"
            android:parentActivityName=".activity.SettingsActivity" />
        <activity android:name=".activity.SetupHostActivity"
            android:exported="false"
            android:parentActivityName=".activity.InputMethodsActivity" />
        <activity android:name=".activity.SetupDirectSelectionActivity"
            android:exported="false"
            android:parentActivityName=".activity.InputMethodsActivity" />
        <activity android:name=".activity.SetupDirectionalSelectionActivity"
            android:exported="false"
            android:parentActivityName=".activity.InputMethodsActivity" />
        <activity android:name=".activity.VocabularyManagementActivity"
            android:exported="false"
            android:parentActivityName=".activity.SettingsActivity" />
        <activity
            android:name=".activity.ExportVocabUsageActivity"
            android:exported="false"
            android:parentActivityName=".activity.ManageVocabulariesActivity" />
        <activity
            android:name=".activity.ManageVocabulariesActivity"
            android:exported="false"
            android:parentActivityName=".activity.VocabularyManagementActivity" />
        <activity
            android:name=".activity.VocabularyImportActivity"
            android:exported="true"
            android:parentActivityName=".activity.VocabularyManagementActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".navigation.NavigationModeService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_navigation" />
        </service>

        <service
            android:name=".JustTypeIME"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Static receiver for package update/reinstall detection -->
        <!-- This survives process death and sets a flag for the IME to reinitialize -->
        <receiver
            android:name=".receiver.PackageUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Note: ExternalInputReceiver and ClearHighlightsReceiver are registered -->
        <!-- dynamically in JustTypeIME.kt to provide callback access to the IME instance. -->
        <!-- Do NOT add static manifest declarations for these receivers, as that would -->
        <!-- cause broadcasts to be received twice. -->

        <!-- FileProvider for the Submit Feedback button (Settings → bottom row).
             Exposes app-private cache files via content:// URIs to other apps
             through Android's share-sheet (email, Drive, etc.). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.continuouspath.justtype.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
